# SJF Non-Preemptive Scheduling

n = int(input("Enter number of processes: "))

process = []
arrival_time = []
burst_time = []

for i in range(n):
    process.append(i+1)
    at = int(input(f"Enter arrival time of P{i+1}: "))
    bt = int(input(f"Enter burst time of P{i+1}: "))
    arrival_time.append(at)
    burst_time.append(bt)

completed = [False]*n
completion_time = [0]*n
tat = [0]*n
wt = [0]*n

time = 0
completed_count = 0

while completed_count < n:
    idx = -1
    min_bt = float('inf')

    for i in range(n):
        if arrival_time[i] <= time and not completed[i]:
            if burst_time[i] < min_bt:
                min_bt = burst_time[i]
                idx = i

    if idx != -1:
        time += burst_time[idx]
        completion_time[idx] = time
        tat[idx] = completion_time[idx] - arrival_time[idx]
        wt[idx] = tat[idx] - burst_time[idx]
        completed[idx] = True
        completed_count += 1
    else:
        time += 1

# Averages
avg_tat = sum(tat)/n
avg_wt = sum(wt)/n

print("\nProcess\tAT\tBT\tCT\tTAT\tWT")
for i in range(n):
    print(f"P{i+1}\t\t{arrival_time[i]}\t{burst_time[i]}\t{completion_time[i]}\t{tat[i]}\t{wt[i]}")

print("\nAverage Turnaround Time =", avg_tat)
print("Average Waiting Time =", avg_wt)

