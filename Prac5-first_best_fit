# First Fit Memory Allocation

def first_fit(blocks, processes):
    allocation = [-1] * len(processes)

    for i in range(len(processes)):
        for j in range(len(blocks)):
            if blocks[j] >= processes[i]:
                allocation[i] = j
                blocks[j] -= processes[i]
                break

    print("\nProcess No.\tProcess Size\tBlock No.")
    for i in range(len(processes)):
        if allocation[i] != -1:
            print(f"{i+1}\t\t\t\t{processes[i]}\t\t\t{allocation[i]+1}")
        else:
            print(f"{i+1}\t\t\t{processes[i]}\t\t\tNot Allocated")


# User Input
m = int(input("Enter number of memory blocks: "))
blocks = list(map(int, input("Enter block sizes: ").split()))

n = int(input("Enter number of processes: "))
processes = list(map(int, input("Enter process sizes: ").split()))

first_fit(blocks, processes)

