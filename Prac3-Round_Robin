# Priority Scheduling (Preemptive)

n = int(input("Enter number of processes: "))

at = list(map(int, input("Enter arrival times: ").split()))
bt = list(map(int, input("Enter burst times: ").split()))
priority = list(map(int, input("Enter priorities: ").split()))

remaining_bt = bt[:]
ct = [0]*n
time = 0
completed = 0

# Lower number = higher priority

while completed < n:
    idx = -1
    highest_priority = float('inf')

    # Find highest priority process among arrived ones
    for i in range(n):
        if at[i] <= time and remaining_bt[i] > 0:
            if priority[i] < highest_priority:
                highest_priority = priority[i]
                idx = i

    if idx != -1:
        # Execute for 1 unit time
        remaining_bt[idx] -= 1
        time += 1

        # If process completes
        if remaining_bt[idx] == 0:
            ct[idx] = time
            completed += 1
    else:
        time += 1

# Calculate TAT and WT
tat = [ct[i] - at[i] for i in range(n)]
wt = [tat[i] - bt[i] for i in range(n)]

# Output
print("\nP\tAT\tBT\tPR\tCT\tTAT\tWT")
for i in range(n):
    print(f"P{i+1}\t{at[i]}\t{bt[i]}\t{priority[i]}\t{ct[i]}\t{tat[i]}\t{wt[i]}")

print("\nAverage TAT =", sum(tat)/n)
print("Average WT =", sum(wt)/n)

