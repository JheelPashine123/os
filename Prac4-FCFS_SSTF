# SSTF Disk Scheduling

def sstf(requests, head):
    total_seek_time = 0
    current = head
    reqs = requests.copy()

    print("\nInitial Head Position:", head)
    print("Seek Sequence:")

    while reqs:
        closest = min(reqs, key=lambda x: abs(x - current))
        movement = abs(closest - current)

        print(f"{current} -> {closest}  (Movement = {movement})")

        total_seek_time += movement
        current = closest
        reqs.remove(closest)

    print("\nTotal Seek Time:", total_seek_time)


# User Input
n = int(input("Enter number of requests: "))
requests = list(map(int, input("Enter disk requests: ").split()))
head = int(input("Enter initial head position: "))

sstf(requests, head)

