import threading
import time

N = 5
chopsticks = [threading.Semaphore(1) for _ in range(N)]

def philosopher(i):
    while True:
        print(f"Philosopher {i} is Thinking")
        time.sleep(1)

        print(f"Philosopher {i} is Hungry")

        # Pick left and right
        chopsticks[i].acquire()
        chopsticks[(i+1) % N].acquire()

        print(f"Philosopher {i} is Eating")
        time.sleep(1)

        # Release
        chopsticks[i].release()
        chopsticks[(i+1) % N].release()


